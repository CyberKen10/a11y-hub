# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- IA (gratis por defecto: Gemini) ---
# google = Google AI Studio (sin tarjeta). openai = API de pago.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# Modelos opcionales (defaults sensatos si se omiten):
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# --- OpenAI (solo si AI_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-5
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Tope diario por persona (medianoche UTC). Evita que alguien se gaste el cupo
# gratis de Gemini del equipo. 0 = bloqueado. Sin estas líneas se usan defaults.
# AI_USER_DAILY_CHAT=20
# AI_USER_DAILY_TRANSCRIBE=8
# AI_USER_DAILY_SPEECH=8
# AI_USER_DAILY_EXTRACT=6

# --- Auth policy ---
# Comma-separated list of email domains allowed to sign up (empty = any).
ALLOWED_EMAIL_DOMAINS=yourcompany.com

# --- Google Sheets mirror (server-only, service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=svc-account@project.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-spreadsheet-id
